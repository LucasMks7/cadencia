{
  "name": "cadencia",
  "version": "2.0.0",
  "description": "PWA que projeta quando você termina cada curso, livro ou matéria a partir da meta diária e do ritmo real — com login Google e sincronização entre aparelhos.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "LucasMks7",
  "homepage": "https://cadencia-app-lm.web.app",
  "repository": { "type": "git", "url": "https://github.com/lucasmks7/cadencia.git" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build-cloud.mjs",
    "patch": "node scripts/patch-index.mjs",
    "serve": "npx --yes serve -l 5173 .",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test tests/sync-core.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cadencia \"node --test tests/firestore.rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-cadencia",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.33.0"
  }
}
